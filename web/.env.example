NEXT_PUBLIC_STRAPI_API_URL=http://127.0.0.1:1337
STRAPI_API_TOKEN=your_strapi_api_token_here

# Where the BFF routes reach Strapi. STRAPI_API_TOKEN above stays server-side —
# the browser talks only to /api/* in this app, never to Strapi directly.
STRAPI_URL=http://127.0.0.1:1337

# WebSocket gateway (omni-socket)
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:4000

# Password behind the demo quick-login buttons. This one does reach the browser
# by design — a one-click demo login cannot work otherwise — so setting it buys
# no secrecy. It keeps the credential out of the repository, and leaving it
# empty simply hides the preset buttons instead of offering ones that fail.
NEXT_PUBLIC_DEMO_USER_PASSWORD=
