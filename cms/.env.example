# Demo mode seeds demo content and wipes it again every night at 04:00, resetting
# every user's affinityGraph along with it. Keep this at false for a real
# deployment. It defaults to ON when unset, so leaving the variable out of your
# environment means your user data gets wiped nightly.
DEMO_MODE=false
