HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Demo mode seeds demo content and wipes it again every night at 04:00, resetting
# every user's affinityGraph along with it. Keep this at false for a real
# deployment. It defaults to ON when unset, so leaving the variable out of your
# environment means your user data gets wiped nightly.
DEMO_MODE=false

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=omni_stack_db
DATABASE_USERNAME=omni_user
DATABASE_PASSWORD=tobemodified

# Local LLM (see docs/AI_VISION_AND_LLM_SERVICES.md)
OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=llama3.1:latest

# Passwords for the seeded demo accounts. They are read from here rather than
# written into the seeding code — these particular credentials are published in
# the README on purpose, but a boilerplate that carries a password literal in
# its source teaches that habit to everyone who copies it.
#
# Leave them unset in a real deployment: the demo users are then not created at
# all, rather than created with a password anyone can look up. Only relevant
# when DEMO_MODE is on.
DEMO_USER_PASSWORD=
DEMO_EDITOR_PASSWORD=
