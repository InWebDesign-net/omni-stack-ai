{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "rm -rf dist && strapi build",
    "postbuild": "mkdir -p dist && ln -sfn ../.strapi/client dist/build && mkdir -p node_modules/@strapi/admin/dist/server/server && ln -sfn ../../../../../../.strapi/client node_modules/@strapi/admin/dist/server/server/build && ln -sfn .strapi/client build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry"
  },
  "dependencies": {
    "@omni/shared": "1.0.0",
