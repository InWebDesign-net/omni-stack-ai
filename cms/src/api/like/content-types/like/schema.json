{
  "kind": "collectionType",
  "collectionName": "likes",
  "info": {
    "singularName": "like",
    "pluralName": "likes",
    "displayName": "Like",
    "description": "User likes on videos, images, articles and feed items"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "userIdentifier": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "video": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::video.video"
    },
    "feedItem": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::feed-item.feed-item"
    },
    "image": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::image.image"
    },
    "article": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::article.article"
    }
  }
}
