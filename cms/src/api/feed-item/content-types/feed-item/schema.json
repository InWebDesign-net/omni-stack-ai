{
  "kind": "collectionType",
  "collectionName": "feed_items",
  "info": {
    "singularName": "feed-item",
    "pluralName": "feed-items",
    "displayName": "Feed Item",
    "description": "Dynamic Content Post assembled by AI Recommendation Matrix"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "thumbnailUrl": {
      "type": "string"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "shared.rich-text",
        "shared.video",
        "shared.media",
        "shared.quote",
        "shared.headline",
        "shared.pdf"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "feedItems"
    },
    "tags": {
      "type": "json",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "viewsCount": {
      "type": "integer",
      "default": 0
    },
    "likesCount": {
      "type": "integer",
      "default": 0
    },
    "publishedAt": {
      "type": "datetime"
    }
  }
}
