{
  "kind": "collectionType",
  "collectionName": "videos",
  "info": {
    "singularName": "video",
    "pluralName": "videos",
    "displayName": "Video",
    "description": "Standalone Video Media Assets with HLS streaming, ABR qualities, and monetization"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tags": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "viewsCount": {
      "type": "integer",
      "default": 0
    },
    "likesCount": {
      "type": "integer",
      "default": 0
    },
    "duration": {
      "type": "integer",
      "default": 0
    },
    "isProcessing": {
      "type": "boolean",
      "default": true
    },
    "isForSale": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "float",
      "default": 0
    },
    "hlsUrl": {
      "type": "string"
    },
    "mp4Url": {
      "type": "string"
    },
    "thumbnailUrl": {
      "type": "string"
    },
    "ogImageUrl": {
      "type": "string"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "shared.rich-text",
        "shared.headline",
        "shared.quote",
        "shared.media"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "creator": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "feedItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::feed-item.feed-item",
      "mappedBy": "video"
    }
  }
}
