{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Magazine articles with component blocks"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "shared.rich-text",
        "shared.video",
        "shared.media",
        "shared.quote",
        "shared.headline",
        "shared.pdf"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "thumbnail": {
      "type": "string"
    },
    "creator": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "viewsCount": {
      "type": "integer",
      "default": 0
    },
    "likesCount": {
      "type": "integer",
      "default": 0
    },
    "commentsCount": {
      "type": "integer",
      "default": 0
    },
    "tags": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "private",
        "public"
      ],
      "default": "public",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isProcessing": {
      "type": "boolean",
      "default": false
    }
  }
}
