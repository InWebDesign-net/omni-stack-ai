PORT=4000

# Must match the CMS value — the gateway verifies the same user JWTs.
# The service refuses to start without it.
JWT_SECRET=tobemodified

STRAPI_URL=http://127.0.0.1:1337

# Origins allowed to open a socket connection, comma-separated.
#
# Unset falls back to local development origins only
# (http://localhost:3000, http://127.0.0.1:3000). Set this to your own domains
# in any deployment reachable from outside your machine.
ALLOWED_ORIGINS=https://your-domain.example

# Accept connections from any origin. Only for a throwaway environment — with
# guest connections enabled this lets any page on the internet open a socket
# against this gateway. ALLOWED_ORIGINS takes precedence when both are set.
ALLOW_ANY_ORIGIN=false
